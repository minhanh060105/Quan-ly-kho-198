! Adapt interface and addresses to your LAN. Firewall: allow IP protocol 112 between peers.
global_defs {
    router_id NODE_A
    script_user root
    enable_script_security
}
vrrp_script check_backend_health {
    script "/usr/local/bin/check_health.sh"
    interval 2
    timeout 3
    weight 0
    init_fail
    fall 2
    rise 2
}
vrrp_instance VI_1 {
    state BACKUP
    interface eth0
    virtual_router_id 51
    priority 101
    advert_int 1
    nopreempt
    unicast_src_ip 192.168.1.101
    unicast_peer {
        192.168.1.102
        192.168.1.103
    }
    virtual_ipaddress {
        192.168.1.200/24
    }
    track_script {
        check_backend_health
    }
}
